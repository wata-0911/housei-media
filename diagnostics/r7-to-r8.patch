diff --git a/tests/authority-r8.browser.mjs b/tests/authority-r8.browser.mjs
new file mode 100644
index 0000000..6e51875
--- /dev/null
+++ b/tests/authority-r8.browser.mjs
@@ -0,0 +1,102 @@
+import { before, after, test } from 'node:test';
+import assert from 'node:assert/strict';
+import { build } from 'esbuild';
+import { createServer } from 'node:http';
+import { files, initialState } from './fixtures/migration-fixture.mjs';
+
+const { chromium } = await import(process.env.PLANNER_PLAYWRIGHT_MODULE || 'playwright');
+const primary = JSON.stringify(initialState());
+let browser;
+const servers = [];
+const origins = [];
+
+before(async () => {
+  const output = await build({ stdin: { resolveDir: new URL('../', import.meta.url).pathname, contents: `
+    import { createPlannerAttemptSession } from './src/planner/attempts/production/session';
+    import { createAuthorityIndexedDbStore } from './src/planner/attempts/persistence/authorityIndexedDb';
+    import { readLegacySnapshot } from './src/planner/attempts/production/authorityAdmission';
+    import { prepareMigrationEnvironment } from './src/planner/attempts/migration/source';
+    export const store = createAuthorityIndexedDbStore(indexedDB);
+    export const make = (legacy = false) => createPlannerAttemptSession(store, navigator.locks,
+      legacy ? { readLegacy: () => readLegacySnapshot(localStorage),
+        migrationEnvironment: () => prepareMigrationEnvironment(${JSON.stringify(files)}),
+        protectAuthority: () => store.protectOriginal() } : undefined);
+  ` }, bundle: true, platform: 'browser', format: 'esm', write: false, logLevel: 'silent' });
+  for (let i = 0; i < 2; i++) {
+    const server = createServer((request, response) => {
+      response.setHeader('Content-Type', request.url === '/bundle.mjs' ? 'text/javascript' : 'text/html');
+      response.end(request.url === '/bundle.mjs' ? output.outputFiles[0].text : '<title>F01 R8 reservation order</title>');
+    });
+    await new Promise(resolve => server.listen(0, '127.0.0.1', resolve));
+    servers.push(server);
+    origins.push(`http://127.0.0.1:${server.address().port}`);
+  }
+  browser = await chromium.launch({ headless: true });
+});
+
+after(async () => {
+  await browser?.close();
+  for (const server of servers) {
+    server.closeAllConnections();
+    await new Promise(resolve => server.close(resolve));
+  }
+});
+
+for (const schema of [23, 24]) for (const commandCount of [0, 1, 16]) {
+  test(`R8 schema${schema} ${commandCount} commands retain ordered reservations across origins`, { timeout: 300000 }, async t => {
+    const sourceContext = await browser.newContext();
+    const destinationContext = await browser.newContext();
+    t.after(async () => { await sourceContext.close(); await destinationContext.close(); });
+    const sourcePage = await sourceContext.newPage();
+    await sourcePage.goto(origins[0]);
+    const source = await sourcePage.evaluate(async ({ schema, commandCount, primary }) => {
+      const { store, make } = await import('/bundle.mjs');
+      if (schema === 23) localStorage.setItem('hosei-planner:v1', primary);
+      const api = make(schema === 23);
+      await api.load();
+      await api.save(schema === 23 ? await api.prepareMigration(primary) : await api.prepareSave(), true);
+      if (commandCount) {
+        api.add('hosei:cp:b99c65d5-5917-422d-bda4-75a4f99ad8b7', JSON.stringify({ plannedYear: 2038, method: 'correspondence', status: 'planned' }));
+        const id = api.graph().attempts.at(-1).id;
+        for (let i = 1; i < commandCount; i++) api.recordContribution(id, JSON.stringify({ value: i % 4 }));
+        await api.save(await api.prepareSave(), true);
+      }
+      const backup = await api.createBackup();
+      return { backup, authority: await store.read(), primary: localStorage.getItem('hosei-planner:v1') };
+    }, { schema, commandCount, primary });
+    assert.equal(source.primary, schema === 23 ? primary : null);
+    const body = JSON.parse(source.backup);
+    assert.equal(body.state.history.commands.length, commandCount);
+    assert.deepEqual(body.reservedIds, source.authority.issuedIds);
+
+    const destinationPage = await destinationContext.newPage();
+    await destinationPage.goto(origins[1]);
+    const destination = await destinationPage.evaluate(async ({ schema, backup }) => {
+      const { store, make } = await import('/bundle.mjs');
+      const api = make(schema === 23);
+      await api.load();
+      const dbBefore = (await indexedDB.databases()).length;
+      let puts = 0;
+      const put = IDBObjectStore.prototype.put;
+      IDBObjectStore.prototype.put = function (...args) { puts++; return put.apply(this, args); };
+      const preview = await api.prepareRestore(backup);
+      const previewPuts = puts;
+      await api.save(preview, true, preview.adoptionSha256);
+      const authority = await store.read();
+      const fresh = make(schema === 23);
+      await fresh.load();
+      const repeated = await fresh.createBackup();
+      return { dbBefore, previewPuts, puts, authority, repeated: JSON.parse(repeated),
+        primary: localStorage.getItem('hosei-planner:v1') };
+    }, { schema, backup: source.backup });
+    assert.equal(destination.dbBefore, 0);
+    assert.equal(destination.previewPuts, 0);
+    assert.equal(destination.puts, 1);
+    assert.equal(destination.primary, null);
+    assert.equal(destination.authority.raw, source.authority.raw);
+    assert.deepEqual(destination.repeated.state, body.state);
+    if (schema === 23) assert.equal(destination.repeated.state.source.raw, primary);
+    assert.deepEqual(destination.authority.issuedIds, source.authority.issuedIds);
+    assert.deepEqual(destination.repeated.reservedIds, body.reservedIds);
+  });
+}
diff --git a/tests/authority-r8.test.mjs b/tests/authority-r8.test.mjs
new file mode 100644
index 0000000..442d254
--- /dev/null
+++ b/tests/authority-r8.test.mjs
@@ -0,0 +1,77 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createAttemptPersistence } from '../src/planner/attempts/persistence/controller.ts';
+import { emptyAuthority } from '../src/planner/attempts/persistence/contracts.ts';
+import { backupDigest } from '../src/planner/digest.ts';
+import { makeAttempt } from '../src/planner/attempts/workbench/catalogView.ts';
+import { newOperationId } from '../src/planner/attempts/workbench/operations.ts';
+
+const locks = { request: async (_name, _options, run) => run() };
+function host() {
+  let record = emptyAuthority();
+  let puts = 0;
+  const store = {
+    read: async () => structuredClone(record),
+    commit: async (expected, next) => {
+      assert.deepEqual(record, expected);
+      record = structuredClone(next);
+      puts++;
+    },
+  };
+  return { api: createAttemptPersistence(store, locks), record: () => structuredClone(record), puts: () => puts };
+}
+async function save(api, preview) {
+  return api.commit(preview, true, preview.previousRaw, preview.sourceRaw);
+}
+async function add(api, handle, title) {
+  const attempt = makeAttempt(handle.source.context.catalog, {
+    title, courseId: null, placementId: null,
+    plan: { plannedYear: null, plannedTerm: null, studyYear: null, status: 'planned', earnedOrder: null },
+    method: 'unknown', note: '',
+  });
+  const preview = await api.prepareEdits(handle, [{ kind: 'add', operationId: attempt.creationOperationId, attempt }]);
+  return { handle: await save(api, preview), attempt };
+}
+
+test('R8 restore keeps existing host prefix, incoming order and removed IDs across another restore', async () => {
+  const source = host();
+  let sourceHandle = await save(source.api, await source.api.prepareNewPlan());
+  const added = await add(source.api, sourceHandle, 'source attempt');
+  sourceHandle = added.handle;
+  sourceHandle = await save(source.api, await source.api.prepareEdits(sourceHandle,
+    [{ kind: 'remove', operationId: newOperationId(), attemptId: added.attempt.id }]));
+  const sourceRaw = source.record().raw;
+  const backup = await source.api.createBackup(sourceHandle);
+  const incoming = JSON.parse(backup).reservedIds;
+  assert.deepEqual(incoming, source.record().issuedIds);
+  assert.ok(incoming.includes(added.attempt.id), 'deleted attempt ID remains reserved');
+
+  const target = host();
+  let targetHandle = await save(target.api, await target.api.prepareNewPlan());
+  targetHandle = (await add(target.api, targetHandle, 'host attempt')).handle;
+  const hostPrefix = target.record().issuedIds;
+  const expected = [...new Set([...hostPrefix, ...incoming])];
+  const hostOnly = hostPrefix.find(id => !incoming.includes(id));
+  assert.ok(hostOnly);
+  const conflicting = JSON.parse(backup);
+  conflicting.reservedIds.push(`hosei:owned:${hostOnly.split(':').at(-1)}`);
+  delete conflicting.sha256;
+  await assert.rejects(target.api.inspectBackup(JSON.stringify({ ...conflicting,
+    sha256: await backupDigest(conflicting) })), /recovery_host_collision|reservation_uuid_collision/);
+  assert.equal(target.puts(), 2, 'alias conflict cannot write');
+  const preview = await target.api.inspectBackup(backup);
+  assert.equal(target.puts(), 2, 'preview is read only');
+  await assert.rejects(save(target.api, preview), /portable_adoption_and_protection_required/);
+  assert.equal(target.puts(), 2, 'missing consent cannot write');
+  await target.api.commit(preview, true, preview.previousRaw, preview.sourceRaw,
+    { acceptedBackupRawSha256: preview.recovery.rawSha256, protectedBackupRaw: backup });
+  assert.deepEqual(target.record().issuedIds, expected);
+  assert.equal(target.record().raw, sourceRaw);
+  const loaded = await target.api.load();
+  const repeated = await target.api.createBackup(loaded);
+  assert.deepEqual(JSON.parse(repeated).reservedIds, expected);
+  const again = await target.api.inspectBackup(repeated);
+  await save(target.api, again);
+  assert.deepEqual(target.record().issuedIds, expected);
+  assert.equal(target.record().raw, sourceRaw);
+});
