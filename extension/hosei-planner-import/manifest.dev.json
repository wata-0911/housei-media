{
  "manifest_version": 3,
  "name": "法政 履修データ取り込み (dev)",
  "version": "1.1.0",
  "description": "法政Web学習サービスの成績表を、この端末内でJSONへ変換します。開発用Planner確認版です。",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://hosei-tsukyo-media.com/*",
    "https://housei-media-egvrrjm8y-htms-projects-5d66bc0c.vercel.app/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": [
      "https://hosei-tsukyo-media.com/*",
      "https://housei-media-egvrrjm8y-htms-projects-5d66bc0c.vercel.app/*"
    ],
    "js": ["planner-bridge.js"],
    "run_at": "document_start"
  }],
  "action": { "default_popup": "popup.html", "default_title": "法政 履修データ取り込み (dev)" }
}
