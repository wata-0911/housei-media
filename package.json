{
  "name": "hosei-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:grade-import && npm run catalog:check && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test:planner": "node --import tsx --test tests/planner.test.mjs tests/curriculum-foundation.test.mjs tests/course-progress.test.mjs tests/curriculum-centered-model.test.mjs tests/curriculum-course-ui.test.mjs tests/component-provenance.test.mjs tests/graduation-audit.test.mjs tests/grade-import-privacy.test.mjs tests/unresolved-conditions.test.mjs",
    "test:extension": "node --test extension/hosei-planner-import/tests/*.test.mjs",
    "build:extension-dev": "npm run check:grade-import && node scripts/build-extension-dev.mjs",
    "catalog:generate": "node --import tsx scripts/generate-curriculum-catalog.mts",
    "catalog:check": "node --import tsx scripts/generate-curriculum-catalog.mts --check",
    "build:grade-import": "node scripts/build-grade-import.mjs",
    "build:bookmarklet": "npm run build:grade-import",
    "check:grade-import": "node scripts/build-grade-import.mjs --check",
    "test:bookmarklet": "npm run check:grade-import && node --import tsx --test bookmarklet/tests/*.test.mjs"
  },
  "dependencies": {
    "@line/liff": "^2.31.2",
    "ajv": "^8.20.0",
    "framer-motion": "^12.38.0",
    "html-to-image": "^1.11.13",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "esbuild": "0.28.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.2.4"
  }
}
