{
  "name": "hosei-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run catalog:check && npm run check:grade-import && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "catalog:check": "node --import tsx scripts/generate-curriculum-catalog.mts --check",
    "check:grade-import": "node scripts/build-grade-import.mjs --check",
    "test:planner:integration": "node --import tsx --test tests/stage63-same-origin-authority.test.mjs tests/grade-import-privacy.test.mjs tests/planner-png-local.test.mjs tests/planner-release-persistence.test.mjs",
    "test:planner": "npm run test:planner:integration",
    "test:planner:browser": "bash tests/planner-release/run.sh",
    "build:planner:release": "bash scripts/planner-release/build.sh"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "framer-motion": "^12.38.0",
    "html-to-image": "^1.11.13",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.2.4",
    "esbuild": "0.28.2",
    "playwright-core": "1.65.1"
  }
}
