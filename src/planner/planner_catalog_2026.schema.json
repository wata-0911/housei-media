              "examGrade": { "anyOf": [{ "enum": ["S", "A+", "A", "A-", "B+", "B", "B-", "C+", "C", "C-", "D"] }, { "type": "null" }] }
            },
            "required": ["offeringId", "requiredReports", "reports", "examGrade"],
            "additionalProperties": false
          }
        }
        ,"importedStudyRecords": { "type": "array", "items": { "type": "object", "properties": {
