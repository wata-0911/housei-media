          "sourceCourseId": { "type": "string", "minLength": 1 }, "earnedCreditsTotal": { "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }] }, "schoolingCreditsTotal": { "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }] }, "compositionCredits": { "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }] }, "recognizedExemption": { "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }] }, "additionalEnrollment": { "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }] }, "capturedAt": { "type": "string" }
        }, "required": ["id", "fingerprint", "source", "rawName", "offeringId", "match", "method", "academicYear", "yearSource", "rawYear", "term", "rawTerm", "date", "credits", "grade"], "additionalProperties": false } }
      },
